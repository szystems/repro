/public/js/*
!/public/js/*.js
/public/css/
/storage/
/bootstrap/cache/
.env
.env.*
.phpunit.result.cache
.DS_Store
Thumbs.db
*.sql
*.backup
*.bat
*.sh
*.log
/.venv/
/.vscode/
# Archivos temporales
*.swp
*.swo
# Backups y configuraciones locales
composer.json.backup
.htaccess_ipage_root
.htaccess_ipage_v2
# Ignorar archivos de pruebas y deployment
scripts/

# Scripts de deploy temporales con credenciales / claves
/deploy_*.php
/public/deploy_*.php

# Documentación con credenciales FTP
/docs/ftp/

# Permitir carpetas necesarias
!storage/framework/.gitignore
!database/.gitignore
!docker/coolify/*.sh
*.Zone.Identifier
